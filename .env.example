# ===================================================
# Store Rating Platform - Environment Configuration Example
# Copy this file to .env and configure values before running
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (PostgreSQL)
# When running with Docker Compose, DB_HOST should be "postgres"
# When running locally on host machine, DB_HOST is typically "localhost"
DB_DIALECT=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=store_rating_db
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here
DB_SSL=false
DB_LOGGING=false

# Authentication (JWT)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
